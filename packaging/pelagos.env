# Environment of the pelagos services and of the /usr/bin/pelagos command.
# The defaults match the packaged layout; uncomment to override.
#PELAGOS_ETC=/etc/pelagos
#PELAGOS_VAR=/var/lib/pelagos
#PELAGOS_RUN=/run/pelagos
#PELAGOS_OPT=/opt/pelagos
# Python settings for the gunicorn worker.
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1
