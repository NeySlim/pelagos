{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "title": "Pelagos",
  "uid": "pelagos-overview",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "tags": [
    "pelagos"
  ],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Nodes up",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bool_yes_no"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (node) (pelagos_node_up)",
          "legendFormat": "{{node}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Open alerts",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (severity) (pelagos_alerts_by_severity)",
          "legendFormat": "{{severity}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Scrape sources",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bool_yes_no"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "pelagos_scrape_success",
          "legendFormat": "{{source}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Version",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "pelagos_build_info",
          "legendFormat": "{{version}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Pool utilization",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (node, engine, subnet, pool) (pelagos_pool_utilization_percent)",
          "legendFormat": "{{node}} {{subnet}} {{pool}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Clock offset",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (node) (pelagos_node_clock_offset_seconds)",
          "legendFormat": "{{node}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "BIND queries per second by type",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (node, qtype) (rate(pelagos_bind_queries_total[5m]))",
          "legendFormat": "{{node}} {{qtype}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "BIND responses per second by code",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (node, rcode) (rate(pelagos_bind_responses_total[5m]))",
          "legendFormat": "{{node}} {{rcode}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Kea packets per second",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "pps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (node, engine, packet) (rate(pelagos_kea_packets_total[5m]))",
          "legendFormat": "{{node}} {{engine}} {{packet}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Kea assigned and declined addresses",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (node, engine) (pelagos_kea_assigned_addresses)",
          "legendFormat": "assigned {{node}} {{engine}}"
        },
        {
          "refId": "B",
          "expr": "max by (node, engine) (pelagos_kea_declined_addresses)",
          "legendFormat": "declined {{node}} {{engine}}"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "HA healthy and unsent updates",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (server) (pelagos_ha_healthy)",
          "legendFormat": "healthy {{server}}"
        },
        {
          "refId": "B",
          "expr": "max by (server) (pelagos_ha_unsent_updates)",
          "legendFormat": "unsent {{server}}"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Zones with divergent serials",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(max by (zone, view) (pelagos_zone_serial_divergent) > 0) or vector(0)",
          "legendFormat": "divergent zones"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Plans per hour (all scraped nodes)",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 36,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (scope, result) (increase(pelagos_plan_applied_total[1h]))",
          "legendFormat": "{{scope}} {{result}}"
        }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "DDNS updates per second",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 36,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (node, counter) (rate(pelagos_d2_updates_total[5m]))",
          "legendFormat": "{{counter}}"
        }
      ]
    }
  ]
}
