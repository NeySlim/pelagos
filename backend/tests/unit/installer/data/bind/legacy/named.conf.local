# Keys shared with Kea D2 and with the secondary, both created years ago.
key "kea-ddns" {
	algorithm hmac-md5;
	secret "bGVnYWN5LWtlYS1kZG5zLXNlY3JldC0wMDAwMDAwMDAwMDA=";
};

key "legacy-xfr" {
	algorithm hmac-sha1;
	secret "bGVnYWN5LXhmci1zZWNyZXQtMDAwMDAwMDAwMDAwMDAwMDA=";
};

/* The forward zone: D2 updates it with the shared key, one host by address. */
zone "example.lan" {
	type primary;
	file "/var/lib/bind/db.example.lan";
	allow-update { key kea-ddns; 192.0.2.5; };
	also-notify { 192.0.2.2; };
	notify explicit;
};

zone "2.0.192.in-addr.arpa" {
	type primary;
	file "/var/lib/bind/db.2.0.192";
	allow-update { 192.0.2.5; 192.0.2.6; };
	allow-transfer { 192.0.2.2; key legacy-xfr; };
};

zone "corp.example.lan" {
	type primary;
	file "/var/lib/bind/db.corp.example.lan";
	update-policy { grant kea-ddns zonesub ANY; };
	allow-transfer { key legacy-xfr; };
};

zone "example.net" {
	type secondary;
	file "db.example.net";
	primaries { 192.0.2.9 key legacy-xfr; };
};
