# SPDX-License-Identifier: Apache-2.0
[Unit]
Description=Pelagos privileged installer helper (one request)
Documentation=https://github.com/NeySlim/pelagos
CollectMode=inactive-or-failed

[Service]
Type=simple
# Root: the installer edits engine files, installs packages and restarts services.
ExecStart=/usr/bin/pelagos helper
StandardInput=socket
StandardOutput=socket
StandardError=journal
UMask=0027
# Journal tag per unit (the collector and the helper both logged as `pelagos`).
SyslogIdentifier=pelagos-helper
# One request per instance: a stuck or silent client never pins a root process for long.
RuntimeMaxSec=3600
TimeoutStopSec=30
