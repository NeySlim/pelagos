# Host 1: copy to .env. The admin password is exported in the shell for the first start only.
PELAGOS_IMAGE=ghcr.io/neyslim/pelagos:0.3.1
PELAGOS_NODE_NAME=ns1
PELAGOS_WEB_URL=https://ns1.example.lan:8443
PELAGOS_REPLICATION_URL=https://ns1.example.lan:8444
PELAGOS_HTTPS_PORT=8443
PELAGOS_REPL_PORT=8444
BIND_DNS_PORT=53
BIND_IMAGE=internetsystemsconsortium/bind9:9.20
KEA_VERSION=3.2.1
PELAGOS_KEA_GID=8450
