#!/bin/sh
# SPDX-License-Identifier: Apache-2.0
# ExecStartPre of the pelagos units, run as root (the units use the "+" prefix).
# Usage: pelagos-prestart [web|collector]   (default web)
# Fails fast when the node is not initialized, gives the service user its configuration
# and state back (pelagos init may have run as root) and, for the web process only, creates
# a self-signed HTTPS certificate when none exists.
set -eu

mode="${1:-web}"
etc="${PELAGOS_ETC:-/etc/pelagos}"
var="${PELAGOS_VAR:-/var/lib/pelagos}"
user="${PELAGOS_USER:-pelagos}"
group="${PELAGOS_GROUP:-$user}"

if [ ! -f "$etc/node.toml" ]; then
  echo "pelagos: $etc/node.toml not found; run 'pelagos init' (first node) or 'pelagos enroll' (join a cluster)" >&2
  exit 78
fi

# Root only touches paths whose parent the service user cannot change ($etc and $var sit
# in root-owned directories). Symlinks are never followed and pelagos.env stays root's:
# /usr/bin/pelagos reads it as root. Only what is not already right is touched.
mkdir -p "$etc" "$var"
find "$etc" "$var" ! -type l ! -path "$etc/pelagos.env" \( ! -user "$user" -o ! -group "$group" \) \
  -exec chown -h "$user:$group" {} + 2>/dev/null || true
# Files written under another umask (an older image, a root CLI run) lose their world bits;
# certificates and pelagos.env are public.
find "$etc" "$var" ! -type l ! -path "$etc/pelagos.env" ! -name '*.crt' -perm /o=rwx \
  -exec chmod o-rwx {} + 2>/dev/null || true
for d in "$etc" "$var"; do
  [ -L "$d" ] || chmod 0750 "$d"
done

# Everything inside the service user's own tree runs with its privileges, so a symlink it
# planted there can never redirect a root write or chmod.
setpriv --reuid "$user" --regid "$group" --init-groups env HOME="$var" sh -eu -c '
  etc="$1"; mode="$2"
  umask 077
  mkdir -p "$etc/tls"
  [ -L "$etc/tls" ] || chmod 0750 "$etc/tls"
  if [ "$mode" = web ] && { [ ! -s "$etc/tls/server.crt" ] || [ ! -s "$etc/tls/server.key" ]; }; then
    host="$(hostname -f 2>/dev/null || hostname)"
    echo "pelagos: creating a self-signed certificate for $host in $etc/tls" >&2
    rm -f "$etc/tls/server.key.new" "$etc/tls/server.crt.new"
    openssl req -x509 -newkey ec -pkeyopt ec_paramgen_curve:prime256v1 -nodes -days 3650 \
      -subj "/CN=$host" -addext "subjectAltName=DNS:$host,DNS:localhost,IP:127.0.0.1" \
      -keyout "$etc/tls/server.key.new" -out "$etc/tls/server.crt.new" >/dev/null 2>&1
    mv -f "$etc/tls/server.key.new" "$etc/tls/server.key"
    mv -f "$etc/tls/server.crt.new" "$etc/tls/server.crt"
  fi
  if [ -f "$etc/tls/server.key" ] && [ ! -L "$etc/tls/server.key" ]; then
    chmod 0600 "$etc/tls/server.key" 2>/dev/null || true
  fi
' pelagos-prestart "$etc" "$mode"
exit 0
