# SPDX-License-Identifier: Apache-2.0
[Unit]
Description=Pelagos web node (API and UI)
Documentation=https://github.com/NeySlim/pelagos
After=network-online.target
Wants=network-online.target pelagos-collector.service
# The package enables the unit; it only starts once pelagos init or enroll has run.
ConditionPathExists=/etc/pelagos/node.toml

[Service]
Type=simple
User=pelagos
Group=pelagos
# Supplementary groups are set by the package postinst (bind or named, _kea or kea).
EnvironmentFile=-/etc/pelagos/pelagos.env
WorkingDirectory=/opt/pelagos
# Runs as root: self-signed HTTPS certificate on first start, ownership of /etc and /var.
ExecStartPre=+/opt/pelagos/bin/pelagos-prestart
ExecStart=/opt/pelagos/venv/bin/gunicorn -c /opt/pelagos/gunicorn_conf.py 'pelagos.app:wsgi_app()'
Restart=on-failure
RestartSec=3
# 75: restart asked after a supplementary group change; not a failure.
SuccessExitStatus=75
RestartForceExitStatus=75
RuntimeDirectory=pelagos
RuntimeDirectoryPreserve=yes
RuntimeDirectoryMode=0750
StateDirectory=pelagos
StateDirectoryMode=0750
ConfigurationDirectory=pelagos
ConfigurationDirectoryMode=0750
# Files created by the services are never world readable (section 3 modes).
UMask=0027
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/pelagos /run/pelagos /etc/pelagos
# Include and zone file directories of the engines, written through the write pipeline.
# Static zone files live next to the user's zones; file permissions still decide.
ReadWritePaths=-/etc/bind -/etc/named -/etc/kea
ReadWritePaths=-/var/cache/bind -/var/lib/bind -/var/named
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# Unprivileged processes on ports above 1024: no capabilities, no kernel or device access.
# The "+" ExecStartPre keeps root for pelagos-prestart.
CapabilityBoundingSet=
AmbientCapabilities=
PrivateDevices=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
