# SPDX-License-Identifier: Apache-2.0
[Unit]
Description=Pelagos collector (polling, series cache, alerts, replication)
Documentation=https://github.com/NeySlim/pelagos
After=network-online.target
Wants=network-online.target
PartOf=pelagos.service
ConditionPathExists=/etc/pelagos/node.toml

[Service]
Type=simple
User=pelagos
Group=pelagos
EnvironmentFile=-/etc/pelagos/pelagos.env
WorkingDirectory=/opt/pelagos
# Runs as root: ownership of /etc and /var when pelagos init ran as root (idempotent).
ExecStartPre=+/opt/pelagos/bin/pelagos-prestart collector
ExecStart=/opt/pelagos/venv/bin/pelagos collector
Restart=on-failure
RestartSec=5
# 75: the engines changed (import or install), restart cleanly to load the new connectors.
# TERM: a stop during ExecStartPre (package upgrade) is a clean stop, not "Failed with result signal".
SuccessExitStatus=75 TERM
RestartForceExitStatus=75
RuntimeDirectory=pelagos
RuntimeDirectoryPreserve=yes
RuntimeDirectoryMode=0750
StateDirectory=pelagos
StateDirectoryMode=0750
ConfigurationDirectory=pelagos
ConfigurationDirectoryMode=0750
# Files created by the services are never world readable (section 3 modes).
UMask=0027
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/pelagos /run/pelagos /etc/pelagos
# Static zone files live next to the user's zones; file permissions still decide.
ReadWritePaths=-/etc/bind -/etc/named -/etc/kea
ReadWritePaths=-/var/cache/bind -/var/lib/bind -/var/named
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# Unprivileged processes on ports above 1024: no capabilities, no kernel or device access.
# The "+" ExecStartPre keeps root for pelagos-prestart.
CapabilityBoundingSet=
AmbientCapabilities=
PrivateDevices=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
