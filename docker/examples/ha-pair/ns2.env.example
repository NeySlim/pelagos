# Host 2: copy to .env. No admin password: ns2 is enrolled, not initialized (see compose.yaml).
# Image tag: latest by default. Pin a release in production, upgrade by changing it:
# PELAGOS_VERSION=0.3.1
PELAGOS_NODE_NAME=ns2
PELAGOS_WEB_URL=https://ns2.example.lan:8443
PELAGOS_REPLICATION_URL=https://ns2.example.lan:8444
PELAGOS_HTTPS_PORT=8443
PELAGOS_REPL_PORT=8444
BIND_DNS_PORT=53
BIND_IMAGE=internetsystemsconsortium/bind9:9.20
KEA_VERSION=3.2.1
PELAGOS_KEA_GID=8450
