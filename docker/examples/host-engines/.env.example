# Copy to .env. Ids from the host: getent group bind _kea; id -u bind
# Image tag: latest by default. Pin a release in production, upgrade by changing it:
# PELAGOS_VERSION=0.3.1
PELAGOS_NODE_NAME=ns1
PELAGOS_WEB_URL=https://ns1.example.lan:8443
PELAGOS_REPLICATION_URL=https://ns1.example.lan:8444
PELAGOS_BIND_GID=
PELAGOS_BIND_UID=
PELAGOS_KEA_GID=
