#!/bin/sh
# SPDX-License-Identifier: Apache-2.0
# Create the pelagos user, its groups and the writable tree of docs/architecture.md section 3.
set -e

case "$1" in
  configure)
    if ! getent passwd pelagos >/dev/null; then
      adduser --quiet --system --group --home /var/lib/pelagos --no-create-home \
        --shell /usr/sbin/nologin --gecos "Pelagos DNS/DHCP manager" pelagos
    fi
    # Engine groups give access to the rndc key, the include directory and the Kea sockets.
    for grp in bind named _kea kea; do
      if getent group "$grp" >/dev/null && ! id -nG pelagos | tr ' ' '\n' | grep -qx "$grp"; then
        adduser --quiet pelagos "$grp" || true
      fi
    done

    install -d -o pelagos -g pelagos -m 0750 /etc/pelagos /etc/pelagos/tls
    install -d -o pelagos -g pelagos -m 0750 /var/lib/pelagos /var/lib/pelagos/audit \
      /var/lib/pelagos/pki /var/lib/pelagos/backups /var/lib/pelagos/plans /var/lib/pelagos/locks
    # A node initialized as root (pelagos init, pelagos install --init) gives its files back to the
    # service user; symbolic links are never followed and pelagos.env stays root's.
    find /etc/pelagos /var/lib/pelagos ! -type l ! -path /etc/pelagos/pelagos.env \
      \( ! -user pelagos -o ! -group pelagos \) -exec chown -h pelagos:pelagos {} + 2>/dev/null || true
    # Root reads this file in /usr/bin/pelagos: the service user must not be able to write it.
    if [ -f /etc/pelagos/pelagos.env ] && [ ! -L /etc/pelagos/pelagos.env ]; then
      chown root:root /etc/pelagos/pelagos.env
      chmod 0644 /etc/pelagos/pelagos.env
    fi

    # Folders the services create or write under the engines' trees (named's effective `directory`
    # included), made here as root: the unit sandbox and the folder modes may forbid it to the
    # service. Missing ones only, existing folders are never changed; each creation is logged.
    if [ -x /opt/pelagos/venv/bin/pelagos ]; then
      pelagos permissions ensure 2>&1 | logger -s -t pelagos-postinst || true
    fi

    if [ -z "$2" ] && [ ! -f /etc/pelagos/node.toml ]; then
      echo "pelagos: installed. Initialize the first node with:" >&2
      echo "    sudo pelagos init --name \$(hostname -s)" >&2
      echo "or join an existing cluster with 'sudo pelagos enroll', then:" >&2
      echo "    sudo systemctl start pelagos pelagos-collector" >&2
    fi
    ;;
esac

#DEBHELPER#

exit 0
